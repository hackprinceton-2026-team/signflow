/**
 * Contract tooling: turns the backend's OpenAPI document (generated from
 * Muhammad's canonical Pydantic models) into TypeScript types for the desktop
 * app, and validates example payloads against it.
 *
 * Node-only. Never import this from the renderer: Ajv compiles validators with
 * `new Function`, which the renderer's CSP (no 'unsafe-eval') correctly blocks.
 */
import { createHash } from 'node:crypto';
import { existsSync, readdirSync, readFileSync, statSync } from 'node:fs';
import { dirname, isAbsolute, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import openapiTS, { astToString, type OpenAPI3 } from 'openapi-typescript';
import Ajv from 'ajv';
import Ajv2020 from 'ajv/dist/2020.js';
import addFormats from 'ajv-formats';

export const DESKTOP_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');

/** Frontend concepts the UI needs, mapped to schema names once the official contract exists. */
export interface ConceptMapping {
  /** Name under `components.schemas` in the official document, or null until known. */
  schema: string | null;
  /** Required concepts must be mapped (and have examples) once a schema exists. */
  required: boolean;
  description: string;
}

export interface ContractConfig {
  /** The pinned contract this app is built against (a byte-for-byte copy of upstream). */
  source: string;
  /** Where the backend publishes the contract. When present, it must equal `source`. */
  upstream?: string;
  examplesDir: string;
  output: string;
  concepts: Record<string, ConceptMapping>;
}

/** `SIGNFLOW_CONTRACT_CONFIG` swaps in another config (used to rehearse the official suite). */
export function loadConfig(
  path = process.env['SIGNFLOW_CONTRACT_CONFIG'] || join(DESKTOP_ROOT, 'contract', 'config.json'),
): ContractConfig {
  const raw = JSON.parse(readFileSync(path, 'utf8')) as ContractConfig & { $comment?: unknown };
  return {
    source: raw.source,
    ...(raw.upstream ? { upstream: raw.upstream } : {}),
    examplesDir: raw.examplesDir,
    output: raw.output,
    concepts: raw.concepts,
  };
}

export function isUrl(source: string): boolean {
  return /^https?:\/\//i.test(source);
}

/** Resolve a config path relative to desktop/. URLs pass through. */
export function resolveSource(source: string): string {
  if (isUrl(source)) return source;
  return isAbsolute(source) ? source : resolve(DESKTOP_ROOT, source);
}

/** `SIGNFLOW_CONTRACT_SOURCE` (path or http URL) overrides the configured source. */
export function contractSource(config: ContractConfig, env = process.env): string {
  return resolveSource(env['SIGNFLOW_CONTRACT_SOURCE'] || config.source);
}

export async function readSourceText(source: string): Promise<string> {
  if (isUrl(source)) {
    const res = await fetch(source);
    if (!res.ok) throw new Error(`Fetching ${source} failed: HTTP ${res.status}`);
    return res.text();
  }
  return readFileSync(source, 'utf8');
}

export type OpenApiDoc = OpenAPI3 & { openapi: string; components?: { schemas?: Record<string, unknown> } };

export function parseOpenApi(text: string): OpenApiDoc {
  let doc: unknown;
  try {
    doc = JSON.parse(text);
  } catch (err) {
    throw new Error(`Contract source is not valid JSON: ${(err as Error).message}`, { cause: err });
  }
  if (!doc || typeof doc !== 'object' || typeof (doc as { openapi?: unknown }).openapi !== 'string') {
    throw new Error('Contract source is not an OpenAPI document (missing "openapi" version field)');
  }
  const version = (doc as { openapi: string }).openapi;
  if (!/^3\.(0|1)\./.test(version)) throw new Error(`Unsupported OpenAPI version ${version} (need 3.0.x or 3.1.x)`);
  return doc as OpenApiDoc;
}

export function schemaNames(doc: OpenApiDoc): string[] {
  return Object.keys(doc.components?.schemas ?? {}).sort();
}

export const GENERATED_BANNER = [
  '/**',
  ' * AUTO-GENERATED by `npm run contract:generate`. DO NOT EDIT.',
  " * Source of truth: the backend's canonical Pydantic models (owner: Muhammad).",
  ' * Regenerate whenever the official OpenAPI document changes.',
  ' */',
].join('\n');

/** Generate the TypeScript module committed at `config.output`. Deterministic for a given source. */
export async function generateTypes(sourceText: string): Promise<string> {
  const doc = parseOpenApi(sourceText);
  const ast = await openapiTS(doc, { alphabetize: true, silent: true });
  const sha = createHash('sha256').update(sourceText).digest('hex');
  return [
    '/* eslint-disable */',
    GENERATED_BANNER,
    '',
    astToString(ast).trimEnd(),
    '',
    '/** True once types come from the official contract (false in the placeholder). */',
    'export const CONTRACT_GENERATED = true as const;',
    `export const CONTRACT_SOURCE_SHA256 = '${sha}';`,
    `export const CONTRACT_OPENAPI_VERSION = '${doc.openapi}';`,
    '',
  ].join('\n');
}

export type Validate = (schemaName: string, value: unknown) => { valid: boolean; errors: string[] };

/** JSON Schema validator for `components.schemas.*` (OpenAPI 3.1 → 2020-12, 3.0 → draft-07 + nullable). */
export function createValidator(doc: OpenApiDoc): Validate {
  const is31 = doc.openapi.startsWith('3.1');
  // strict: false because OpenAPI documents carry non-JSON-Schema keys
  // (paths, info, discriminator.mapping, ...).
  const ajv = is31 ? new Ajv2020({ strict: false, allErrors: true }) : new Ajv({ strict: false, allErrors: true });
  addFormats(ajv);
  ajv.addSchema(doc as object, 'contract');
  return (schemaName, value) => {
    if (!doc.components?.schemas?.[schemaName]) {
      return { valid: false, errors: [`schema "${schemaName}" does not exist in the contract`] };
    }
    const pointer = schemaName.replace(/~/g, '~0').replace(/\//g, '~1');
    const validate = ajv.getSchema(`contract#/components/schemas/${pointer}`);
    if (!validate) return { valid: false, errors: [`could not compile schema "${schemaName}"`] };
    const valid = validate(value) as boolean;
    const errors = (validate.errors ?? []).map((e) => `${e.instancePath || '(root)'} ${e.message ?? 'is invalid'}`);
    return { valid, errors };
  };
}

export interface ExampleFile {
  schema: string;
  file: string;
  expectValid: boolean;
}

/**
 * Example payloads live in `<examplesDir>/<SchemaName>/*.json` (valid) and
 * `<examplesDir>/<SchemaName>/invalid/*.json` (must be rejected).
 */
export function listExamples(examplesDir: string): ExampleFile[] {
  if (!existsSync(examplesDir)) return [];
  const out: ExampleFile[] = [];
  for (const schema of readdirSync(examplesDir).sort()) {
    const dir = join(examplesDir, schema);
    if (!statSync(dir).isDirectory()) continue;
    for (const f of readdirSync(dir).sort()) {
      if (f.endsWith('.json')) out.push({ schema, file: join(dir, f), expectValid: true });
    }
    const invalid = join(dir, 'invalid');
    if (existsSync(invalid)) {
      for (const f of readdirSync(invalid).sort()) {
        if (f.endsWith('.json')) out.push({ schema, file: join(invalid, f), expectValid: false });
      }
    }
  }
  return out;
}

export interface InlineExample {
  schema: string;
  index: number;
  value: unknown;
}

/** Examples the backend embeds in its schemas (`components.schemas.X.examples`). */
export function inlineExamples(doc: OpenApiDoc): InlineExample[] {
  const out: InlineExample[] = [];
  for (const [schema, def] of Object.entries(doc.components?.schemas ?? {})) {
    const examples = (def as { examples?: unknown }).examples;
    if (Array.isArray(examples)) examples.forEach((value, index) => out.push({ schema, index, value }));
  }
  return out;
}

/** `SIGNFLOW_CONTRACT_UPSTREAM` (path or http URL) overrides the configured upstream. */
export function contractUpstream(config: ContractConfig, env = process.env): string | undefined {
  const upstream = env['SIGNFLOW_CONTRACT_UPSTREAM'] || config.upstream;
  return upstream ? resolveSource(upstream) : undefined;
}

/** Problems with the concept → schema mapping for a given official document. */
export function mappingProblems(config: ContractConfig, doc: OpenApiDoc): string[] {
  const names = new Set(schemaNames(doc));
  const problems: string[] = [];
  for (const [concept, m] of Object.entries(config.concepts)) {
    if (m.schema === null) {
      if (m.required) problems.push(`"${concept}" is required but not mapped to a schema in contract/config.json`);
    } else if (!names.has(m.schema)) {
      problems.push(`"${concept}" maps to "${m.schema}", which is not in components.schemas`);
    }
  }
  return problems;
}
