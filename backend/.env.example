# SignFlow backend configuration. Copy to backend/.env and fill in.
# backend/.env is gitignored: never commit real keys.

# --- Translation (Gemini) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
TRANSLATE_TIMEOUT_S=20

# --- Speech (Amazon Polly) ---
# AWS credentials are NOT set here: boto3 uses the standard AWS chain
# (aws configure / AWS_PROFILE / SSO / AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY in your shell).
AWS_REGION=us-east-1
# generative = Polly's most natural, human-like voices. Recommended: Ruth (default),
# Danielle or Matthew. Generative voices are offered in a subset of regions (us-east-1 works).
POLLY_ENGINE=generative
# Retried once with this engine if the chosen voice doesn't support POLLY_ENGINE (empty = no retry).
POLLY_FALLBACK_ENGINE=neural
POLLY_DEFAULT_VOICE=Ruth
SPEAK_TIMEOUT_S=20

# --- Server ---
# Comma-separated exact origins. '*' is rejected.
CORS_ORIGINS=app://signflow,http://localhost:5173
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
